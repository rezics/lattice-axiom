{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rezics.dev/lattice-axiom/docs/implementation-evidence.schema.json",
  "title": "Lattice Axiom implementation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "implementation", "evidence"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "production_paths", "product_entries", "checks"],
        "properties": {
          "requirement_id": { "type": "string" },
          "status": { "enum": ["scaffolded", "partial", "verified"] },
          "production_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "product_entries": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "checks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}


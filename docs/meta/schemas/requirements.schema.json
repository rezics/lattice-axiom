{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rezics.dev/lattice-axiom/docs/requirements.schema.json",
  "title": "Lattice Axiom requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "owner", "requirements"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "document_id", "level", "statement", "acceptance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+(?:-[A-Z0-9]+)+$" },
          "document_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "level": { "enum": ["must", "should"] },
          "statement": { "type": "string", "minLength": 1 },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "supersedes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}


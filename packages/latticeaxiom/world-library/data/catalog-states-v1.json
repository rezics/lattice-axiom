{
  "authoring_schema": "latticeaxiom:schema/world-catalog-states@1",
  "owner_package": "@latticeaxiom/world-library",
  "opens_writer": false,
  "states": [
    {
      "id": "ready-exact",
      "continue": true,
      "next": "prepare-launch-intent"
    },
    {
      "id": "ready-compatible",
      "continue": false,
      "next": "accept-compatible-diff"
    },
    {
      "id": "missing-package",
      "continue": false,
      "next": "prepare-package"
    },
    {
      "id": "migration-required",
      "continue": false,
      "next": "checkpoint-clone-migrate"
    },
    {
      "id": "recoverable",
      "continue": false,
      "next": "restore-checkpoint-or-repair"
    },
    {
      "id": "read-only",
      "continue": false,
      "next": "inspect-or-export"
    },
    {
      "id": "corrupt",
      "continue": false,
      "next": "inspect-recovery"
    }
  ],
  "operations": [
    { "id": "create", "opens_writer": false },
    { "id": "continue", "requires_state": "ready-exact", "prepares_launch_intent": true, "opens_writer": false },
    { "id": "preflight", "opens_writer": false },
    { "id": "recovery", "opens_writer": false },
    { "id": "checkpoint", "opens_writer": false },
    { "id": "clone", "new_world_identity": true, "copies_process_local_lease": false, "opens_writer": false },
    { "id": "trash", "opens_writer": false },
    { "id": "export", "includes_secrets": false, "opens_writer": false }
  ]
}

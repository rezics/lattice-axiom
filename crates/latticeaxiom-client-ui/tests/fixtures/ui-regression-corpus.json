{
  "schema_id": "latticeaxiom.ui-regression-corpus.v1",
  "requirement_ids": ["CLIENT-UI-001", "CLIENT-SURFACE-STATE-001"],
  "viewport": {
    "width": 800,
    "height": 600
  },
  "scales": ["one", "two"],
  "cjk_fallback_font": "latticeaxiom:asset/font/cjk-fallback@1",
  "injection_sources": ["keyboard", "mouse", "gamepad"],
  "ime": {
    "composition": "한",
    "commit": "世界",
    "committed_name": "世界"
  },
  "rebind": {
    "row": "settings/controls/pause",
    "action_id": "latticeaxiom:action/ui/pause@1",
    "candidate": {
      "schema_version": 1,
      "encoding": "keyboard:key-p"
    }
  },
  "accesskit_roles": {
    "shell": "Application",
    "shell/home": "Navigation",
    "new-world/name": "TextInput",
    "modal/pause": "Dialog",
    "overlay/inventory": "Group",
    "overlay/workbench": "Group"
  },
  "shell_journey": [
    {
      "inject_target": "home/new-world",
      "expect_route": "new-world"
    },
    {
      "inject_target": "new-world/back",
      "expect_route": "home"
    }
  ],
  "deferred_cases": [
    {
      "id": "os-screen-reader-smoke",
      "kind": "manual",
      "blocking": false,
      "requires_window": false,
      "requires_gpu": false,
      "reason": "ADR 0025: OS screen-reader operation is optional evidence and does not block CI."
    },
    {
      "id": "pixel-screenshot-comparison",
      "kind": "gpu-window",
      "blocking": false,
      "requires_window": true,
      "requires_gpu": true,
      "reason": "ADR 0025: pixel screenshot and GPU visual comparison are not blocking gates."
    },
    {
      "id": "physical-controller-and-os-ime",
      "kind": "manual",
      "blocking": false,
      "requires_window": true,
      "requires_gpu": false,
      "reason": "ADR 0025: physical controller and OS IME human smoke is optional, not a blocking gate."
    }
  ]
}

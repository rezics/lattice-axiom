{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "latticeaxiom:schema/performance-evidence-v1",
  "title": "PerformanceEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "profile",
    "lifecycle_status",
    "scenario",
    "mode",
    "measurement_tool",
    "histogram_version",
    "normative_render_pass_permitted",
    "reference_host_run",
    "fingerprints",
    "protocol",
    "metrics",
    "high_waters",
    "queues",
    "path",
    "faults",
    "streaming_profile",
    "observation_sha256",
    "overall"
  ],
  "properties": {
    "schema": { "const": "latticeaxiom:schema/performance-evidence-v1" },
    "schema_version": { "const": 1 },
    "profile": { "const": "desktop-reference-v1" },
    "lifecycle_status": {
      "type": "string",
      "enum": ["d2-provisional", "d10-frozen"]
    },
    "scenario": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["smoke", "traversal"] },
    "measurement_tool": {
      "const": "latticeaxiom-performance-evidence/v1"
    },
    "histogram_version": { "const": "nearest-rank-v1" },
    "normative_render_pass_permitted": { "type": "boolean" },
    "reference_host_run": { "type": "boolean" },
    "fingerprints": { "type": "object" },
    "protocol": { "type": "object" },
    "metrics": { "type": "object" },
    "high_waters": { "type": "object" },
    "queues": { "type": "object" },
    "path": { "type": "object" },
    "faults": { "type": "object" },
    "streaming_profile": {},
    "observation_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "overall": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gate_verdict", "run_has_failing_metric", "reason"],
      "properties": {
        "gate_verdict": {
          "type": "string",
          "enum": ["pass", "fail", "insufficient-evidence", "unsupported"]
        },
        "run_has_failing_metric": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
